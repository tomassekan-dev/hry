            { id: 4, name: "Modernizace posilovny", desc: "Nové činky místo betonových tvárnic.", category: "Vybavení", approved: false },

            { id: 5, name: "Cyklistický kurz kolem Třeboně", desc: "Pohodová cykloturistika a stanování.", category: "Kurz", approved: false },

            { id: 6, name: "Venkovní boulderingová stěna", desc: "Využití prázdné fasády tělocvičny.", category: "Investice", approved: false },

            { id: 7, name: "Nové florbalové hokejky a branky", desc: "Staré jsou z roku 1994 a zlámané.", category: "Vybavení", approved: false },

            { id: 8, name: "Kurz přežití v brdských lesích", desc: "Orientace v přírodě, stavba přístřeší.", category: "Kurz", approved: false },

            { id: 9, name: "Plavecký výcvik v Aquaparku", desc: "Zdokonalení techniky a tobogány.", category: "Výuka", approved: false },

            { id: 10, name: "Turnaj v Bubble Fotbalu", desc: "Zábavný turnaj v nafukovacích koubích.", category: "Akce", approved: false }

        ];


        // Absurd Counters & Rejection Responses from Rudovous & Chroust

        const absurdRejections = [

            {

                rudovous: "Nejde to! Proč? Protože nechci! Místo haly uspořádáme Vánoční turnaj ve volejbale v červnu na rozpáleném asfaltu!",

                chroust: "Šéfe, přesně tak! Na asfaltu se aspoň nepřezouvá!"

            },

            {

                rudovous: "Rafty v Rakousku? Ani náhodou! Žáci půjdou raději s panem Chroustem sázet brambory na školní pozemek v dešti!",

                chroust: "Výborný nápad, pane řediteli! Mám připravené motyky!"

            },

            {

                rudovous: "Nové florbalové hokejky? Nesmysl! Zmáčknou se plastové lahve od Kofoly a bude se hrát s nimi!",

                chroust: "Ekologické a úsporné, pane řediteli!"

            },

            {

                rudovous: "Lyžování v Alpách? Zákaz! Místo toho bude běh do schodů v plynových maskách z majetku civilní obrany!",

                chroust: "To posílí jejich plíce i disciplínu!"

            },

            {

                rudovous: "Posilovna? Chcete z dětí vychovat hulváty? Kupte jim raději košťata, uklidí listí okolo školy!",

                chroust: "To je také fyzická práce, Adame!"

            },

            {

                rudovous: "Lezecká stěna? A co když mi pošpiní fasádu? Raději udělají 500 dřepů u tabule!",

                chroust: "Přesně tak, fasáda byla nedávno natřená!"

            },

            {

                rudovous: "Plavecký kurz? Voda je drahá! Ať si napustí doma vanu a trénují splývání tam!",

                chroust: "A ušetříme za pedagogický dozor!"

            },

            {

                rudovous: "Bubble fotbal? Znárodním ty koule na uskladnění školního zelí!",

                chroust: "Skvělý nápad pro školní jídelnu!"

            }

        ];


        let selectedIdeaId = 1;

        let rejectedCount = 0;

        let approvedCount = 0;

        let adamPatience = 100;

        let rudovousAnger = 15;


        // Timing Bar State

        let needlePosition = 0; // 0 to 100

        let needleDirection = 1; // 1 or -1

        let needleSpeed = 1.2; // Speed multiplier

        let targetLeft = 45; // %

        let targetWidth = 6; // % (Very narrow! Almost impossible by default)

        let isChroustDistracted = false;


        // Web Audio Synthesizer for Retro Sound Effects

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();


        function playSound(type) {

            try {

                if (audioCtx.state === 'suspended') {

                    audioCtx.resume();

                }

                const osc = audioCtx.createOscillator();

                const gain = audioCtx.createGain();

                osc.connect(gain);

                gain.connect(audioCtx.destination);


                if (type === 'reject') {

                    osc.type = 'sawtooth';

                    osc.frequency.setValueAtTime(180, audioCtx.currentTime);

                    osc.frequency.exponentialRampToValueAtTime(60, audioCtx.currentTime + 0.3);

                    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);

                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);

                    osc.start();

                    osc.stop(audioCtx.currentTime + 0.3);

                } else if (type === 'approve') {

                    osc.type = 'triangle';

                    osc.frequency.setValueAtTime(440, audioCtx.currentTime);

                    osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.4);

                    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);

                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);

                    osc.start();

                    osc.stop(audioCtx.currentTime + 0.5);

                } else if (type === 'click') {

                    osc.type = 'sine';

                    osc.frequency.setValueAtTime(600, audioCtx.currentTime);

                    gain.gain.setValueAtTime(0.1, audioCtx.currentTime);

                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);

                    osc.start();

                    osc.stop(audioCtx.currentTime + 0.05);

                }

            } catch (e) {

                // Audio context block fallback

            }

        }


        /* --- INITIALIZATION --- */

        window.onload = function() {

            renderIdeas();

            startTimingLoop();

            updateStatsUI();

           

            // Randomly shift clock

            setInterval(() => {

                const date = new Date();

                document.getElementById('clock-display').innerText = date.toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

            }, 1000);

        };


        /* --- RENDER IDEAS LIST --- */

        function renderIdeas() {

            const container = document.getElementById('ideas-container');

            container.innerHTML = '';


            ideas.forEach(idea => {

                const isSelected = idea.id === selectedIdeaId;

                const card = document.createElement('div');

                card.onclick = () => selectIdea(idea.id);

               

                card.className = `p-3 rounded-xl border-2 transition cursor-pointer flex items-center justify-between ${

                    idea.approved

                        ? 'bg-emerald-950/40 border-emerald-600/60 opacity-60'

                        : isSelected

                            ? 'bg-amber-950/70 border-amber-500 shadow-md transform scale-[1.01]'

                            : 'bg-gray-800/80 border-gray-700 hover:border-gray-600'

                }`;


                card.innerHTML = `

                    <div class="flex items-center space-x-3">

                        <div class="w-7 h-7 rounded-lg flex items-center justify-center font-bold text-xs ${

                            idea.approved ? 'bg-emerald-600 text-white' : isSelected ? 'bg-amber-500 text-black' : 'bg-gray-700 text-gray-300'

                        }">

                            ${idea.approved ? '✓' : idea.id}

                        </div>

                        <div>

                            <div class="text-xs font-bold ${idea.approved ? 'line-through text-gray-400' : 'text-gray-100'}">${idea.name}</div>

                            <div class="text-[10px] text-gray-400">${idea.desc}</div>

                        </div>

                    </div>

                    <span class="text-[9px] px-2 py-0.5 rounded-full ${

                        idea.category === 'Kurz' ? 'bg-blue-900/60 text-blue-300 border border-blue-700' :

                        idea.category === 'Investice' ? 'bg-purple-900/60 text-purple-300 border border-purple-700' :

                        'bg-teal-900/60 text-teal-300 border border-teal-700'

                    }">${idea.category}</span>

                `;

                container.appendChild(card);

            });

        }


        function selectIdea(id) {

            playSound('click');

            selectedIdeaId = id;

            renderIdeas();

        }


        /* --- TIMING NEEDLE ANIMATION LOOP --- */

        function startTimingLoop() {

            function updateNeedle() {

                needlePosition += needleSpeed * needleDirection;


                if (needlePosition >= 100) {

                    needlePosition = 100;

                    needleDirection = -1;

                } else if (needlePosition <= 0) {

                    needlePosition = 0;

                    needleDirection = 1;

                }


                // Random small jumps in target zone position to make it elusive

                if (Math.random() < 0.01) {

                    targetLeft = Math.floor(Math.random() * 70) + 15; // 15% to 85%

                    updateTargetZoneUI();

                }


                document.getElementById('timing-needle').style.left = `${needlePosition}%`;

                requestAnimationFrame(updateNeedle);

            }

            requestAnimationFrame(updateNeedle);

        }


        function updateTargetZoneUI() {

            const zone = document.getElementById('target-zone');

            zone.style.left = `${targetLeft}%`;

            zone.style.width = `${targetWidth}%`;

        }


        /* --- TACTICS (HELPERS) --- */

        function useTactic(type) {

            playSound('click');

            const coffeeBtn = document.getElementById('btn-coffee');

            const flatterBtn = document.getElementById('btn-flatter');

            const chroustBtn = document.getElementById('btn-chroust');


            if (type === 'coffee') {

                needleSpeed = Math.max(0.4, needleSpeed * 0.65);

                showDialogue("Ředitel Rudovous", "Hmm, káva... Bez lóru! Ale nenechám se opít rohlíkem, Adame!", "Taktika");

                coffeeBtn.disabled = true;

                coffeeBtn.classList.add('opacity-40');

            } else if (type === 'flatter') {

                targetWidth = Math.min(20, targetWidth + 4);

                updateTargetZoneUI();

                showDialogue("Ředitel Rudovous", "Můj plnovous? Ano, pečuji o něj olejem z divočáka. Ale zpět k věci!", "Pochvala");

                flatterBtn.disabled = true;

                flatterBtn.classList.add('opacity-40');

            } else if (type === 'chroust') {

                isChroustDistracted = true;

                const chroustBubble = document.getElementById('chroust-bubble');

                chroustBubble.classList.remove('hidden');

                chroustBubble.innerText = "Chrup, chrup... Ty křídy vypadají chutně...";

                showDialogue("Pan Chroust", "Mňam, barevná křída! Na chvíli přestávám radit!", "Zabaven");

                chroustBtn.disabled = true;

                chroustBtn.classList.add('opacity-40');

               

                setTimeout(() => {

                    chroustBubble.classList.add('hidden');

                }, 4000);

            }

        }


        /* --- MAIN ACTION: PRESENT IDEA --- */

        function presentIdea() {

            const currentIdea = ideas.find(i => i.id === selectedIdeaId);

            if (!currentIdea || currentIdea.approved) {

                showDialogue("Ředitel Rudovous", "Tento nápad už je vyřešený nebo neplatný! Vyberte jiný!", "Upozornění");

                return;

            }


            // Check hit in target zone

            const isHit = needlePosition >= targetLeft && needlePosition <= (targetLeft + targetWidth);


            const rudovousContainer = document.getElementById('rudovous-container');

           

            if (isHit) {

                // SUCCESS! (Extremely rare / well timed)

                playSound('approve');

                currentIdea.approved = true;

                approvedCount++;

                rudovousAnger = Math.max(0, rudovousAnger - 20);

               

                rudovousContainer.classList.add('animate-nod');

                setTimeout(() => rudovousContainer.classList.remove('animate-nod'), 1000);


                showDialogue("Ředitel Rudovous", `Cože?! No dobře... Zrovna mám slabou chvilku. Schvaluji: "${currentIdea.name}"! Ale ať se to neopakuje!`, "SCHVÁLENO!");


                // Shift target zone for next attempt

                targetLeft = Math.floor(Math.random() * 70) + 15;

                targetWidth = 5; // Reset back to hard

                updateTargetZoneUI();

                renderIdeas();

                updateStatsUI();


                if (approvedCount >= 1) {

                    // Win condition met! (Even 1 approval is a legendary achievement)

                    setTimeout(() => {

                        showModal("NEUVĚŘITELNÝ ÚSPĚCH!", `Dokázal jste to! Adam trefil ten jediný zlomek vteřiny v roce! Projekt "${currentIdea.name}" byl oficiálně podepsán a razítkován Rudovousem!`);

                    }, 1200);

                }


            } else {

                // REJECTION (ABSURD RESPONSE)

                playSound('reject');

                rejectedCount++;

                adamPatience = Math.max(0, adamPatience - 12);

                rudovousAnger = Math.min(100, rudovousAnger + 15);


                rudovousContainer.classList.add('animate-shake');

                setTimeout(() => rudovousContainer.classList.remove('animate-shake'), 400);


                // Pick an absurd response

                const randomRejection = absurdRejections[rejectedCount % absurdRejections.length];

               

                showDialogue("Ředitel Rudovous", randomRejection.rudovous, "ZAMÍT NUTO");


                // Show Chroust comment if not distracted

                if (!isChroustDistracted) {

                    const chroustBubble = document.getElementById('chroust-bubble');

                    chroustBubble.innerText = randomRejection.chroust;

                    chroustBubble.classList.remove('hidden');

                    setTimeout(() => {

                        chroustBubble.classList.add('hidden');

                    }, 3500);

                }


                updateStatsUI();


                if (adamPatience <= 0) {

                    setTimeout(() => {

                        showModal("ADAMOVO VYHOŘENÍ!", "Učiteli Adamovi došla veškerá trpělivost. Raději podal výpověď a odešel trénovat akvabely do obecního rybníka. Rudovous vyhrál!");

                    }, 1000);

                }

            }

        }


        /* --- UI UPDATES --- */

        function showDialogue(speaker, text, tag) {

            document.getElementById('speaker-name').innerHTML = `<i class="fa-solid fa-bullhorn"></i> ${speaker}:`;

            document.getElementById('dialogue-text').innerText = `"${text}"`;

            document.getElementById('dialogue-tag').innerText = tag;

        }


        function updateStatsUI() {

            document.getElementById('patience-val').innerText = `${adamPatience}%`;

            document.getElementById('patience-bar').style.width = `${adamPatience}%`;


            document.getElementById('anger-val').innerText = `${rudovousAnger}%`;

            document.getElementById('anger-bar').style.width = `${rudovousAnger}%`;


            document.getElementById('approved-count').innerText = `${approvedCount} / 10`;

            document.getElementById('rejected-count').innerText = rejectedCount;

        }


        /* --- MODAL --- */

        function showModal(title, text) {

            document.getElementById('modal-title').innerText = title;

            document.getElementById('modal-text').innerText = text;

            document.getElementById('game-modal').classList.remove('hidden');

        }


        function resetGame() {

            adamPatience = 100;

            rudovousAnger = 15;

            rejectedCount = 0;

            approvedCount = 0;

            needleSpeed = 1.2;

            targetWidth = 6;

            targetLeft = 45;

            isChroustDistracted = false;


            ideas.forEach(i => i.approved = false);


            document.getElementById('btn-coffee').disabled = false;

            document.getElementById('btn-coffee').classList.remove('opacity-40');

            document.getElementById('btn-flatter').disabled = false;

            document.getElementById('btn-flatter').classList.remove('opacity-40');

            document.getElementById('btn-chroust').disabled = false;

            document.getElementById('btn-chroust').classList.remove('opacity-40');


            document.getElementById('game-modal').classList.add('hidden');

           

            updateTargetZoneUI();

            renderIdeas();

            updateStatsUI();

            showDialogue("Ředitel Rudovous", "Co tu zase chcete, Adame? Tělocvik je přežitek. Děti mají sedět a vyplňovat výkazní tabulky!", "Reakce");

        }

    </script>

