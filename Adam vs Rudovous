        /* Shaking & Animation Effects */

        @keyframes shake {

            0%, 100% { transform: translate(0, 0) rotate(0deg); }

            20% { transform: translate(-4px, 4px) rotate(-2deg); }

            40% { transform: translate(4px, -2deg) rotate(2deg); }

            60% { transform: translate(-4px, -2deg) rotate(-1deg); }

            80% { transform: translate(4px, 2deg) rotate(1deg); }

        }

        .animate-shake {

            animation: shake 0.4s ease-in-out;

        }


        @keyframes nod {

            0%, 100% { transform: translateY(0); }

            50% { transform: translateY(-8px); }

        }

        .animate-nod {

            animation: nod 0.5s ease-in-out 2;

        }


        /* Office desk texture */

        .wood-panel {

            background: linear-gradient(135deg, #422006 0%, #291305 100%);

            border: 4px solid #78350f;

        }


        /* Speech Bubble Tail */

        .speech-bubble::after {

            content: '';

            position: absolute;

            left: -12px;

            top: 24px;

            border-width: 8px 12px 8px 0;

            border-style: solid;

